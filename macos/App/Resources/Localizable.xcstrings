            "value": "Этот Mac отвязан"
          }
        }
      }
    },
    "This chat could not be read: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать чат: %@"
          }
        }
