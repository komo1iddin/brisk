    },
    "The passwords don't match.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароли не совпадают."
          }
        }
      }
    },
    "The unreadable archive is set aside, not deleted, and this Mac links again from scratch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечитаемый архив будет отложен, а не удален, и этот Mac будет привязан заново."
