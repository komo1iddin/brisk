      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуться можно, только отвязав этот Mac от телефона; пароль при этом тоже сбрасывается. Сообщения, уже скопированные сюда, останутся в локальном архиве. Затем снова привяжите Mac с телефона."
          }
        }
      }
    },
    "The part of the picture the sticker keeps": {
      "localizations": {
