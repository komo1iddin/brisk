/* The search over the top of an open chat. Keys are read by
   Search/SearchText.swift; the words live here, not in the code. */

/* The field */
"search.prompt" = "Search";
"search.prompt.people" = "Who sent it?";
"search.clear" = "Clear";
"search.you" = "You";

/* The count of matches */
"search.counter %lld %lld" = "%1$lld of %2$lld";
"search.count %lld" = "%lld found";
"search.count.more %lld" = "%lld+ found";
"search.none" = "No results";
"search.searching" = "Searching";

/* The bar's buttons */
"search.older" = "Older match (↑ or Return)";
"search.newer" = "Newer match (↓ or Shift-Return)";
"search.sender" = "Search by sender";
"search.kind" = "Search by kind";
"search.calendar" = "Go to a date";
"search.close" = "Close search (Esc)";
"search.filter.remove" = "Remove this filter";

/* Kinds of message */
"search.kind.any" = "Any Kind";
"search.kind.photos" = "Photos";
"search.kind.videos" = "Videos";
"search.kind.gifs" = "GIFs";
"search.kind.files" = "Files";
"search.kind.links" = "Links";
"search.kind.voice" = "Voice Messages";
"search.kind.music" = "Music";

/* The list of matches and of people */
"search.list.more %lld %lld" = "The newest %1$lld of %2$lld matches are listed. ↑ and ↓ step through all of them.";
"search.list.truncated" = "Too many matches to step through them all. Add a word or a filter to narrow the search.";
"search.people.none" = "No one by that name";

/* The calendar */
"search.calendar.previous" = "Previous month";
"search.calendar.next" = "Next month";
"search.calendar.goto" = "Go to Day";
"search.calendar.filter" = "Search Day";
"search.calendar.every" = "Search Every Day";
"search.calendar.empty" = "No messages that day";
