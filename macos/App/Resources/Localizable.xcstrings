    },
    "These shortcuts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сочетания клавиш"
          }
        }
      }
    },
    "They are removed from your phone and linked devices. Other people keep their copies. Connect to WhatsApp to delete them. It can't be undone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они будут удалены с вашего телефона и связанных устройств. У других людей копии останутся. Чтобы удалить их, подключитесь к WhatsApp. Это действие нельзя отменить."
          }
        }
      }
    },
    "This GIPHY API key was rejected. Create a free key at developers.giphy.com and paste it here. It is saved in your settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ключ API GIPHY отклонен. Создайте бесплатный ключ на developers.giphy.com и вставьте его сюда. Он сохранится в ваших настройках."
          }
        }
      }
    },
