        "en": {
          "stringUnit": {
            "state": "new",
            "value": "ZapFast uses the camera for video calls, only while yours is on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapFast использует камеру для видеозвонков, только пока она включена."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "ZapFast uses the microphone for voice messages and calls, only when you start one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapFast использует микрофон для голосовых сообщений и звонков, только когда вы их начинаете."
          }
        }
      }
    }
