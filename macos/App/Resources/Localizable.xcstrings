    },
    "This chat is not available": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат недоступен"
          }
        }
      }
    },
    "This clears every message in your chat with %@, including downloaded media, on this Mac and on your phone. The chat itself stays. It can't be undone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сообщения в чате с %@, включая загруженные медиафайлы, будут удалены на этом Mac и на телефоне. Сам чат останется. Это действие нельзя отменить."
          }
        }
      }
    },
    "This conversation is read-only": {
      "localizations": {
